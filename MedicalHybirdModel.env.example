# Copy to `MedicalHybirdModel.env` and adjust. All values have sensible local defaults.

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Lighter footprint alternative: mistral:7b-instruct-q4
# Medical-tuned alternatives: meditron, biomistral
OLLAMA_TRIAGE_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120
# Max generated tokens. 768 fits a full symptom differential without truncation
# (512 clipped longer ones). Raise for very long answers at the cost of latency.
OLLAMA_NUM_PREDICT=768
# Stronger judge for `python -m eval.groundedness` / `eval.bench_models`.
OLLAMA_JUDGE_MODEL=llama3.1:8b
# GPU layers to offload. Leave unset for auto-detect; set to 0 to force CPU
# (do this if Ollama crashes with a CUDA / "device kernel image is invalid" error).
# OLLAMA_NUM_GPU=0

# --- Embeddings ---
# Biomedical-tuned (better, heavier):
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
# Lighter/faster general option:
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Reranker (optional) ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true

# --- Retrieval ---
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
# Fusion weights chosen from data (python -m eval.tune_retrieval): BM25-leaning
# 0.4/0.6 beat the old 0.5/0.5 on the eval set's MRR.
DENSE_WEIGHT=0.4
BM25_WEIGHT=0.6

# --- Chunking ---
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=50

# --- Symptom ML (free-text classifier) ---
# On by default: the classifier embeds the raw symptom text with the RAG encoder
# (train == serve), so it's in-distribution at serve time. Supplementary signal
# only — the grounded LLM answer is authoritative. Train: python -m ml_model.text_train
ML_IN_LIVE_PATH=true
# Abstain (show no ML) when the top class is below this probability.
ML_MIN_CONFIDENCE=0.30
